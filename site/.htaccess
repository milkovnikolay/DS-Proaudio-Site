# ---- redirects:end ----
# ---- Приём заявок с форм: /api/lead, /api/showroom, /api/tour, /api/service -> api/lead.php ----
RewriteRule ^api/(lead|showroom|tour|service)$ api/lead.php?ep=$1 [L,QSA]
# ---- Стартовая страница, без листинга ----
DirectoryIndex index.html Main.dc.html
Options -Indexes -MultiViews
ServerSignature Off
ErrorDocument 404 /404.html
# ---- Закрыть служебное ----
<FilesMatch "\.(jsonl|log|bak|env|mjs|py|md|sh|sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(\.htaccess|\.gitignore|server\.js|Thumbs\.db|\.DS_Store)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/service-api(/|$)
RedirectMatch 404 ^/(cards-variants(-motion)?|menu-proposal(-demo)?|showroom-3d)\.html$
# ---- Заголовки безопасности ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # ---- CSP: с каких адресов странице можно загружать скрипты, стили, шрифты, картинки, видео и встроенные окна ----
  # Проверено 29.10.2026 в режиме ЗАПРЕТА на всех 373 страницах (русские и английские), на ПК и телефоне:
  # нарушений нет, карты, видео, 3D и формы работают (отчёт docs/launch/csp-hsts.md). Зачем нужен каждый адрес:
  #   script-src 'unsafe-inline'   — небольшие скрипты прямо в страницах (меню, формы, галереи) — есть на всех страницах;
  #   script-src 'unsafe-eval'     — распаковка 3D-модели на «Производстве» (WebAssembly); главной с 30.10.2026 не нужен (она в обычном HTML);
  #   шрифты — свои (site/fonts/, задача 7), поэтому fonts.googleapis.com и fonts.gstatic.com больше не нужны;
  #   font-src data:, img-src data: blob: — встроенные значки и текстуры 3D-модели;
  #   mc.yandex.ru, mc.yandex.com, yastatic.net (script, img, connect, frame, child), wss://mc.yandex.* — Яндекс Метрика и Вебвизор
  #     (задача 6, site/metrika.js; список — по справке Метрики «Установка счётчика на сайт с CSP»);
  #   frame-ancestors metrika.yandex.ru … — интерфейс Метрики показывает сайт внутри себя (карты кликов и скроллинга).
  #     X-Frame-Options SAMEORIGIN выше это запрещает, поэтому карты Метрики заработают, когда включим боевой CSP:
  #     браузер с боевым frame-ancestors сам перестаёт смотреть на X-Frame-Options;
  #   YouTube (www.youtube-nocookie.com) убран: видео с YouTube с карточек ERA сняты (задача 8). Появится встроенное видео — вернуть;
  #   frame-src yandex.ru          — карты Яндекса на странице «Контакты» (появляются по кнопке «Показать карту»);
  #   vk.com и rutube.ru из frame-src убраны: на сайте нет встроенных видео VK и Rutube. Появятся — вернуть.
  #
  # Сейчас — режим наблюдения (Report-Only): ничего не блокирует, только пишет предупреждения в консоль браузера.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.com; media-src 'self' blob:; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com; frame-src https://yandex.ru blob: https://mc.yandex.ru https://mc.yandex.com; child-src blob: https://mc.yandex.ru https://mc.yandex.com; frame-ancestors 'self' https://metrika.yandex.ru https://metrica.yandex.com https://metrika.yandex.by https://metrika.yandex.kz https://metrika.yandex.com.tr https://metrica.yandex.ru https://metrika.ya.ru https://metrica.ya.ru; object-src 'none'; base-uri 'self'; form-action 'self' mailto:"
  #
  # БОЕВОЙ CSP. Включать ТОЛЬКО после того, как сайт заработал на хостинге по HTTPS и проверен по памятке (docs/launch/pereezd.md):
  #   1) убрать # в начале строки «Header always set Content-Security-Policy …» ниже;
  #   2) поставить # в начале строки «…-Report-Only» выше;
  #   3) открыть главную, каталог, карточку TAURA 8, «Контакты» (показать карту), карточку ERA (видео), «Производство» (3D) —
  #      в консоли браузера (F12) не должно быть сообщений «Refused to…». Если есть — вернуть как было и написать Тимуру.
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.com; media-src 'self' blob:; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com; frame-src https://yandex.ru blob: https://mc.yandex.ru https://mc.yandex.com; child-src blob: https://mc.yandex.ru https://mc.yandex.com; frame-ancestors 'self' https://metrika.yandex.ru https://metrica.yandex.com https://metrika.yandex.by https://metrika.yandex.kz https://metrika.yandex.com.tr https://metrica.yandex.ru https://metrika.ya.ru https://metrica.ya.ru; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; upgrade-insecure-requests"

  # ---- HSTS: браузер будет открывать сайт только по HTTPS ----
  # Включать НЕ РАНЬШЕ, чем через неделю после переезда, когда HTTPS без ошибок работает на ds-proaudio.ru и www.ds-proaudio.ru
  # и сертификат продлевается автоматически. Убрать # в начале строки ниже. Отменить быстро нельзя: браузеры, которые уже
  # увидели заголовок, год не будут открывать сайт по HTTP, даже если HTTPS сломается. Без includeSubDomains и без preload:
  # поддомены (например, почта) этим правилом не затрагиваются.
  # Header always set Strict-Transport-Security "max-age=31536000"

  # ---- Кэш в браузере ----
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|woff2|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # 3D-модель (assets/3d/taura8.dat) и site.webmanifest — тоже 10 минут, потом браузер сверяет, не изменился ли файл
  <FilesMatch "\.(html|js|css|json|xml|txt|dat|webmanifest)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
# ---- Сжатие ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddCharset UTF-8 .html .css .js .json .txt .xml
