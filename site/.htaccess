# DS PROAUDIO — настройки сервера Apache для хостинга RU-CENTER (план безопасности Коли, п. 1.3, приложение А).
# Работает только на обычном хостинге; превью на GitHub Pages этот файл не читает.
# CSP пока в режиме наблюдения (Report-Only): ничего не блокирует, только сообщает в консоли браузера.
# Готовые строки боевого CSP и HSTS — в разделе «Заголовки безопасности», там же сказано, когда их включать.

# ---- HTTPS ----
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www -> без www (если выбран такой вариант)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# Старая главная -> корень. Включить, когда на сайте появится index.html (иначе корень сайта не откроется)
# RewriteRule ^Main\.dc\.html$ / [R=301,L]
# ---- redirects:start — старые адреса ds-proaudio.ru → новые страницы (tools/seo/redirects.py) ----
