# DS PROAUDIO — настройки сервера Apache для хостинга RU-CENTER (план безопасности Коли, п. 1.3, приложение А).
# Работает только на обычном хостинге; превью на GitHub Pages этот файл не читает.
# CSP пока в режиме наблюдения (Report-Only): ничего не блокирует, только сообщает в консоли браузера.
# После проверки и переноса шрифтов на сайт заменить на Content-Security-Policy и убрать fonts.*.

# ---- HTTPS ----
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www -> без www (если выбран такой вариант)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# Старая главная -> корень. Включить, когда на сайте появится index.html (иначе корень сайта не откроется)
# RewriteRule ^Main\.dc\.html$ / [R=301,L]
# ---- Стартовая страница, без листинга ----
DirectoryIndex index.html Main.dc.html
Options -Indexes -MultiViews
ServerSignature Off
ErrorDocument 404 /404.html
# ---- Закрыть служебное ----
<FilesMatch "\.(jsonl|log|bak|env|mjs|py|md|sh|sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(\.htaccess|\.gitignore|server\.js|Thumbs\.db|\.DS_Store)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/service-api(/|$)
RedirectMatch 404 ^/(cards-variants(-motion)?|menu-proposal(-demo)?|showroom-3d)\.html$
# ---- Заголовки безопасности ----
<IfModule mod_headers.c>
  # HSTS включать только после того, как HTTPS заработает на всех адресах сайта (убрать # в начале строки)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # CSP сначала в режиме Report-Only; после переноса шрифтов убрать fonts.*
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://yandex.ru https://vk.com https://rutube.ru; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; upgrade-insecure-requests"
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|woff2|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|js|css|json|xml|txt)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
# ---- Сжатие ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
AddType font/woff2 .woff2
AddCharset UTF-8 .html .css .js .json .txt .xml
